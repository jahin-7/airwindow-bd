# Live observations. Free key: https://explore.openaq.org/register
# Leave empty to run in clearly-labelled historical replay mode.
OPENAQ_API_KEY=
# Hours after which an observation is shown as stale and forecasts pause
STALE_AFTER_HOURS=3
CORS_ORIGINS=http://localhost:3010
RATE_LIMIT_PER_MIN=120
# Optional overrides
# AIRWINDOW_DATA_DIR=../../data/kaggle_upload
# AIRWINDOW_ARTIFACTS=../../ml/artifacts
